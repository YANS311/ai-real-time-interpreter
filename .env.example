# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Whisper (faster-whisper) — Win/Mac/Linux 通用
# 可选: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_WARMUP=True

# 流式分片时长（秒），0.3 = 300ms 低延迟
AUDIO_CHUNK_DURATION_SEC=0.3
PIPELINE_TIMEOUT_SEC=120

# 口语压缩（ASR 后规整英文口语文本，再送翻译）
SPEECH_COMPRESSOR_ENABLED=True
SPEECH_COMPRESSOR_MIN_CHARS=12

# PPT / 演讲上下文最大字符数
PPT_CONTEXT_MAX_CHARS=4000

# Django Channels WebSocket（开发默认 InMemory，无需 Redis）
CHANNELS_ENABLED=True

# Redis（Docker Compose 自动注入 redis://redis:6379/0）
# 本地直连：REDIS_URL=redis://127.0.0.1:6379/0
# 未配置时：WebSocket 用内存层，会话存进程内存
REDIS_URL=
REDIS_SESSIONS_ENABLED=True
REDIS_MAX_CONNECTIONS=20

# 大模型翻译（OpenAI 兼容 API）
# OpenAI 示例：
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini
# DeepSeek 示例（二选一，注释掉上面三行后使用）：
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-chat

# Edge-TTS 中文音色
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 七牛云 Kodo 对象存储（可选）
# 控制台获取：https://portal.qiniu.com/
QINIU_ACCESS_KEY=your-qiniu-access-key
QINIU_SECRET_KEY=your-qiniu-secret-key
QINIU_BUCKET=your-bucket-name
QINIU_DOMAIN=https://your-cdn-domain.com

# 会话过期（秒）
SESSION_TTL=3600

# 视频/文件上传大小上限（MB）
DATA_UPLOAD_MAX_MB=200

# 默认术语表（可选）格式：英文=中文,API=应用程序接口
# GLOSSARY=Whisper=语音识别,GPT=生成式预训练模型
