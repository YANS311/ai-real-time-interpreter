# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Whisper (faster-whisper) — Win/Mac/Linux 通用
# 可选: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# 流式分片时长（秒），0.3 = 300ms 低延迟
AUDIO_CHUNK_DURATION_SEC=0.3
PIPELINE_TIMEOUT_SEC=120

# 大模型翻译（OpenAI 兼容 API）
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini

# Edge-TTS 中文音色
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 七牛云 Kodo 对象存储（加分项，音视频云端保存）
# 控制台获取：https://portal.qiniu.com/
QINIU_ACCESS_KEY=your-qiniu-access-key
QINIU_SECRET_KEY=your-qiniu-secret-key
QINIU_BUCKET=your-bucket-name
QINIU_DOMAIN=https://your-cdn-domain.com

# 会话过期（秒）
SESSION_TTL=3600

# 默认术语表（可选）格式：英文=中文,API=应用程序接口
# GLOSSARY=Whisper=语音识别,GPT=生成式预训练模型
